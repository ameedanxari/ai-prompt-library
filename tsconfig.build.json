{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": false
  },
  "include": [
    "src/index.ts",
    "src/completion/**/*.ts",
    "src/execution/**/*.ts",
    "src/release/**/*.ts",
    "src/task-contract/**/*.ts",
    "src/traceability/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "tests", "src/**/*.test.ts"]
}
