#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run tests before commit
npm test

# Run the same review-enforcement gates used by CI.
bash scripts/validate-review-enforcement.sh

STAGED_FILES=$(git diff --cached --name-only)

# Check for any .kiro files that might have been accidentally staged
if printf '%s\n' "$STAGED_FILES" | grep -q "\.kiro"; then
  echo "❌ Error: .kiro files should not be committed"
  echo "These files are for internal development only:"
  printf '%s\n' "$STAGED_FILES" | grep "\.kiro"
  echo ""
  echo "Please unstage these files:"
  echo "git reset HEAD $(printf '%s\n' "$STAGED_FILES" | grep '\.kiro' | tr '\n' ' ')"
  exit 1
fi

# Check for any temporary or generated files
TEMP_FILES=$(printf '%s\n' "$STAGED_FILES" | grep -E "\.(tmp|temp|log)$|chat-transcript\.md|raw_chat\.txt" || true)
if [ ! -z "$TEMP_FILES" ]; then
  echo "❌ Error: Temporary files should not be committed:"
  echo "$TEMP_FILES"
  echo ""
  echo "Please unstage these files and add them to .gitignore if needed"
  exit 1
fi

# Check for large files (>1MB)
LARGE_FILES=$(printf '%s\n' "$STAGED_FILES" | while IFS= read -r file; do
  if [ -n "$file" ] && [ -f "$file" ]; then
    size=$(stat -f%z "$file" 2>/dev/null || stat -c%s "$file" 2>/dev/null || echo 0)
    if [ "$size" -gt 1048576 ]; then
      echo "$file"
    fi
  fi
done)
if [ ! -z "$LARGE_FILES" ]; then
  echo "⚠️  Warning: Large files detected (>1MB):"
  echo "$LARGE_FILES"
  echo ""
  echo "Consider if these files should be committed or added to .gitignore"
  echo "Press Enter to continue or Ctrl+C to abort"
  read
fi

echo "✅ Pre-commit checks passed"
